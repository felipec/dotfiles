#!/usr/bin/env ruby

PID_FILE = File.join(Dir.home, '.cache/record-pid')

if File.exist?(PID_FILE)
  pid = File.read(PID_FILE).to_i
  begin
    Process.kill('TERM', pid)
    exit 0
  rescue Errno::ESRCH
    exit 1
  ensure
    File.delete(PID_FILE) rescue nil
  end
end

File.write(PID_FILE, Process.pid.to_s)

f = File.join(Dir.home, 'documents/videos/record-%s.mkv' % Time.now.strftime('%FT%R'))
display = ENV.fetch('DISPLAY')

cmd = %W[
  ffmpeg
  -f x11grab -thread_queue_size 1024 -i #{display}
  -f pulse -i default
  -c:v hevc_nvenc -qp 20
  -c:a aac
  -y #{f}
]

exec(*cmd)
