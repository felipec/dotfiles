#!/usr/bin/env ruby

require 'dbus'

PID_FILE = File.join(Dir.home, '.cache/record-pid')

if File.exist?(PID_FILE)
  pid = File.read(PID_FILE).to_i
  begin
    Process.kill('TERM', pid)
    exit 0
  rescue Errno::ESRCH
    exit 1
  ensure
    File.delete(PID_FILE) rescue nil
  end
end

bus = DBus.session_bus

class StatusNotifierItem < DBus::Object
  dbus_interface 'org.freedesktop.DBus.Properties' do
    dbus_method :GetAll, 'in s, out a{sv}' do |iface|
      return [{}] unless iface == 'org.kde.StatusNotifierItem'
      [{
        'Id' => 'recording',
        'IconName' => 'media-record',
      }]
    end
  end
end

bus.object_server.export(StatusNotifierItem.new('/StatusNotifierItem'))

watcher = bus.service('org.kde.StatusNotifierWatcher')
watcher.object('/StatusNotifierWatcher')
       .tap { |o| o['org.kde.StatusNotifierWatcher']
       .RegisterStatusNotifierItem('/StatusNotifierItem') }

f = File.join(Dir.home, 'documents/videos/record-%s.mkv' % Time.now.strftime('%FT%R'))
display = ENV.fetch('DISPLAY')

cmd = %W[
  ffmpeg
  -f x11grab -thread_queue_size 1024 -i #{display}
  -f pulse -thread_queue_size 1024 -i default
  -c:v hevc_nvenc -qp 20 -preset p5 -tune ll -pix_fmt yuv420p
  -c:a aac -b:a 160k
  -y #{f}
]

pid = spawn(*cmd)
File.write(PID_FILE, pid.to_s)

at_exit do
  File.delete(PID_FILE) rescue nil
end

dbus_thread = Thread.new do
  DBus::Main.new.tap { |m| m << bus }.run
end

Process.wait(pid)

Thread.kill(dbus_thread)
